{
  "name": "vozen-helper-bot-site",
  "version": "0.0.0",
  "private": true,
  "description": "Site (landing + legais) do Vozen Helper — bot de moderação e comunidade para Discord.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:site": "node tools/minify-site.mjs",
