    "test:all": "npm run test && npm run test:ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.48.0"
  }
}
